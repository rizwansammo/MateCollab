# Normalise text files to LF in the repository and working tree on every platform.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.otf  binary
*.ttf  binary
*.pdf  binary
*.zip  binary

# Generated files: collapsed in diffs.
pnpm-lock.yaml linguist-generated=true -diff
packages/contracts/src/generated/** linguist-generated=true
services/go.sum linguist-generated=true
